# GitHub OAuth App / GitHub App credentials
# Create at: https://github.com/settings/developers (OAuth App) for quickest start
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# A classic Personal Access Token (read:user, public_repo) used for
# fetching PUBLIC profiles of users who have not signed in.
GITHUB_PUBLIC_TOKEN=ghp_your_server_token

# NextAuth
NEXTAUTH_SECRET=run_openssl_rand_base64_32_to_generate
NEXTAUTH_URL=http://localhost:3000

# Upstash Redis (optional — app falls back to in-memory cache if absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe (Pro tier). Leave blank to disable billing — Pro checkout returns 503.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
